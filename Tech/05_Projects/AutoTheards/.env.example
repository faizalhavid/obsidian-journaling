# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Binus Microsoft SSO credentials
BINUS_USERNAME=your_nim@binus.ac.id
BINUS_PASSWORD=your_password

# Flask
FLASK_SECRET_KEY=change-me-in-prod
FLASK_ENV=development

# Anthropic (IBM ICA proxy — already set in ~/.claude/settings.json for Claude Code sessions)
ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica

# SQLite database path (default: todos.db in project root)
DATABASE_URL=sqlite:///todos.db

# Playwright session cookie file (default: .sessions/binus_session.json)
# SESSION_FILE=.sessions/binus_session.json
