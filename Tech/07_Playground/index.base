filters:
  and:
    - file.hasTag("playground")
    - file.inFolder("07_Playground")
properties:
  note.area:
    displayName: Area
  note.topic:
    displayName: Topic
  note.status:
    displayName: Status
  note.source:
    displayName: Source
views:
  - type: table
    name: Semua Playground
    filters:
      and:
        - '!file.name.endsWith(".base")'
        - '!file.name.startsWith("README")'
    order:
      - file.name
      - area
      - topic
      - status
    sort:
      - property: area
        direction: ASC
      - property: status
        direction: ASC
  - type: table
    name: AI Engineering
    filters:
      and:
        - note.area == "AI Engineering"
    order:
      - file.name
      - topic
      - status
  - type: table
    name: Software Engineering
    filters:
      and:
        - note.area == "Software Engineering"
    order:
      - file.name
      - topic
      - status
  - type: table
    name: DevOps
    filters:
      and:
        - note.area == "DevOps"
    order:
      - file.name
      - topic
      - status
  - type: table
    name: Database
    filters:
      and:
        - note.area == "Database"
    order:
      - file.name
      - topic
      - status
  - type: table
    name: Data Engineering
    filters:
      and:
        - note.area == "Data Engineering"
    order:
      - file.name
      - topic
      - status
  - type: table
    name: Cyber Security
    filters:
      and:
        - note.area == "Cyber Security"
    order:
      - file.name
      - topic
      - status
